<% layout("/layouts/boilerplate") %>
<%- include("../includes/filters") %>

<style>
    .base-price{
        display:inline;
    }
    .tax-price{
        display:none;
    }

    .listing-link{
        text-decoration:none;
        color:black;
    }

    .listing-link:hover{
        color:black;
    }

    .listing-card{
        border:none;
        transition:.25s;
    }

    .listing-card:hover{
        transform:translateY(-4px);
    }

    .card-img-top{
        width:100%;
        height:300px;
        object-fit:cover;
        border-radius:1rem;
    }

    .listing-title{
        color:#222;
        font-weight:700;
        margin-top:.7rem;
        margin-bottom:.3rem;
        font-size:1.35rem;
    }

    .card-text{
        color:#222;
    }

    .base-price{
        display:inline;
    }

    .tax-price{
        display:none;
    }

    @media(max-width:992px){
        .card-img-top{
            height:260px;
        }
    }

    @media(max-width:768px){
        .card-img-top{
            height:230px;
        }
    }

    @media(max-width:576px){
        .card-img-top{
            height:250px;
        }
    }
</style>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mt-3">
    <% for(let listing of allListings){ %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                    >
                    <div class="card-body">
                        <h5 class="listing-title">
                            <%= listing.title %>
                        </h5>
                        <p class="card-text mb-0">
                            <span class="base-price">
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                            </span>
                            <span class="tax-price">
                                &#8377;<%= Math.round(listing.price*1.18).toLocaleString("en-IN") %>/night (incl. GST)
                            </span>
                        </p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>